# ---------------------------------------------------------------------------
# Supabase (Postgres + Auth + Storage)
# Create a project at https://supabase.com, then copy these from
# Project Settings -> API and Project Settings -> Database.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the client

# Prisma connects directly to Supabase's Postgres for migrations/queries.
# Use the "connection pooling" string for DATABASE_URL (app runtime) and the
# direct connection string for DIRECT_URL (migrations). Both are on the
# Supabase dashboard under Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Field-level encryption for the owner PII table (Section 5 of the spec).
# Generate with: openssl rand -hex 32
# Rotate this by re-encrypting existing rows -- do not lose the old key
# before re-encryption is complete, or that data is unrecoverable.
# ---------------------------------------------------------------------------
OWNER_PII_ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Notifications (rent-due / lease-renewal / maintenance-update emails).
# Mock provider is used automatically if this is unset -- see
# src/lib/notifications/provider.ts. Swap in Resend, SendGrid, etc. for prod.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Cron auth: Vercel Cron calls /api/notifications/cron on a schedule (see
# vercel.json). This shared secret stops anyone else from triggering it.
# ---------------------------------------------------------------------------
CRON_SECRET=replace-with-a-random-string
